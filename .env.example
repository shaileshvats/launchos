# Copy to .env (git-ignored). scripts/setup.sh fills SWITCH_REGISTRATION_TOKEN for you.
SWITCH_API_URL=http://127.0.0.1:8000
SWITCH_GATEWAY_URL=http://localhost:3000
MATTERMOST_URL=http://localhost:8065
MATTERMOST_TEAM=switch
# The Switch server's agent registration token (AGENT_REGISTRATION_TOKEN in switch/.env)
SWITCH_REGISTRATION_TOKEN=
# Human invited into every launch room (the Mattermost user the Switch stack seeds)
SWITCH_HUMAN_USER=user
# Any OpenAI-compatible endpoint. Default: LM Studio on this machine.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen/qwen3-4b-2507
LLM_API_KEY=
# auto = use the model when reachable, else clearly-labelled offline templates; live = require it; offline = never call it
LLM_MODE=auto
STAGE_TIMEOUT=420
